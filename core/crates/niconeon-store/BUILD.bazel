load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/bazel:rust_defs.bzl", "RUST_2021")

rust_library(
    name = "niconeon-store",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "niconeon_store",
    crate_root = "src/lib.rs",
    edition = RUST_2021,
    visibility = ["//core:__subpackages__"],
    deps = [
        "//core/crates/niconeon-domain",
        "@crates//:anyhow",
        "@crates//:chrono",
        "@crates//:directories",
        "@crates//:regex",
        "@crates//:rusqlite",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "unit_test",
    crate = ":niconeon-store",
    deps = [
        "//core/crates/niconeon-domain",
        "@crates//:anyhow",
        "@crates//:chrono",
        "@crates//:directories",
        "@crates//:regex",
        "@crates//:rusqlite",
        "@crates//:serde_json",
    ],
)
